  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB208\uC744 \uAC10\uC740 \uAC80\uAC1D, \uD751. \uAE38\uC744 \uC5EC\uB294
    \uD718\uD30C\uB78C, \uBC31.\n\n\uD718\uD30C\uB78C\uC758 \uBC18\uD5A5\uC774 \uC5B4\uB460
    \uC18D \uC724\uACFD\uC744 \uC9E7\uAC8C \uADF8\uB9B0\uB2E4.\n\uC18C\uB9AC\uAC00
    \uD37C\uC9C0\uB294 \uC21C\uAC04, \uB290\uB824\uC9C4 \uC2DC\uAC04 \uC0AC\uC774\uB85C
    \uAC80\uC744 \uBED7\uC5B4\uB77C.\n\nSPACE \uD718\uD30C\uB78C \xB7 TAB \uAC80
    \uBAA8\uB4DC \uC804\uD658 \xB7 \uC790\uB3D9 \uC804\uC9C4\n\uB4DC\uB798\uADF8\uB85C
    \uC9C1\uC811 \uBCA0\uAE30 / \uD074\uB9AD \uD55C \uBC88\uC73C\uB85C \uAC10\uC9C0\uB41C
    \uC801 \uC77C\uAD04 \uBCA0\uAE30\n\uC138 \uAD6C\uAC04\uC744 \uD1B5\uACFC\uD574
    \uBC31\uC744 \uC0B0\uBB38\uAE4C\uC9C0 \uD638\uC704\uD558\uC138\uC694."
